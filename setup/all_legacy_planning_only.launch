<launch>
  <arg name="handheld_auto" default="false"/>
  <arg name="handheld_height_limit" default="false"/>
  <arg name="handheld_z_min" default="0.1"/>
  <arg name="handheld_z_max" default="0.4"/>
  <arg name="handheld_z_samples" default="3"/>
  <arg name="start_camera" default="true"/>
  <arg name="start_vins" default="true"/>
  <arg name="start_sloam" default="true"/>
  <arg name="start_loop" default="true"/>
  <!-- SLC candidate generator (author's loop_closure_submap_node.py). Without it
       /factor_graph_atl/loop_closure_submap has no publisher and the planner's
       loop_closure_ids_ stays empty, so no semantic loop closure target is ever planned.
       Defaults below equal the original hard-coded values (multi-floor building scale). -->
  <arg name="start_loop_candidates" default="$(arg start_loop)"/>
  <arg name="slc_floor_height" default="3.5"/>
  <arg name="slc_cluster_distance" default="3.5"/>
  <arg name="slc_cluster_min_samples" default="4"/>
  <arg name="slc_max_key_pose_cluster_distance" default="7.0"/>
  <arg name="slc_min_key_pose_to_landmark" default="1.5"/>
  <arg name="start_semantic" default="true"/>
  <arg name="start_cloud" default="true"/>
  <arg name="start_cop" default="true"/>
  <arg name="start_planner" default="true"/>
  <arg name="start_rviz" default="true"/>
  <arg name="disable_ir_emitter" default="false"/>
  <arg name="semantic_cpu_threads" default="0"/>
  <arg name="semantic_cpu_nice" default="0"/>

  <include if="$(arg start_camera)" file="$(find realsense2_camera)/launch/rs_camera.launch">
    <arg name="enable_color" value="true"/>
    <arg name="color_width" value="640"/>
    <arg name="color_height" value="480"/>
    <arg name="color_fps" value="30"/>
    <arg name="enable_depth" value="true"/>
    <arg name="depth_width" value="640"/>
    <arg name="depth_height" value="480"/>
    <arg name="depth_fps" value="30"/>
    <arg name="enable_infra" value="true"/>
    <arg name="enable_infra1" value="true"/>
    <arg name="enable_infra2" value="true"/>
    <arg name="infra_width" value="640"/>
    <arg name="infra_height" value="480"/>
    <arg name="infra_fps" value="30"/>
    <arg name="enable_gyro" value="true"/>
    <arg name="enable_accel" value="true"/>
    <arg name="unite_imu_method" value="linear_interpolation"/>
    <arg name="align_depth" value="true"/>
  </include>
  <!-- Optional VIO diagnostic: projected IR dots may impair feature tracking.
       Camera calibration and estimator parameters are left unchanged. -->
  <node if="$(arg start_vins)" pkg="vins" type="vins_node" name="vins_estimator"
        launch-prefix="$(env HOME)/Desktop/ActiveSLAM_move2Laptop/setup/vins_launch_prefix.sh $(arg disable_ir_emitter)"
        args="$(env HOME)/vins_ws/src/VINS-Fusion/config/realsense_d435i_sunny/realsense_stereo_imu_config.yaml" output="screen"/>
  <include if="$(arg start_loop)" file="$(find loop_closure)/launch/loop_closure_node.launch"/>
  <node if="$(arg start_loop_candidates)" pkg="scan2shape_launch" type="loop_closure_submap_node.py"
        name="loop_closure_submap_node" output="screen">
    <param name="reference_frame" value="world"/>
    <param name="floor_height" value="$(arg slc_floor_height)"/>
    <param name="cluster_distance" value="$(arg slc_cluster_distance)"/>
    <param name="cluster_min_samples" value="$(arg slc_cluster_min_samples)"/>
    <param name="max_key_pose_cluster_distance" value="$(arg slc_max_key_pose_cluster_distance)"/>
    <param name="min_key_pose_to_landmark" value="$(arg slc_min_key_pose_to_landmark)"/>
  </node>
  <include if="$(arg start_sloam)" file="$(find sloam)/launch/run_indoor_large_scale_exploration_sunny.launch">
    <arg name="enable_rviz" value="false"/>
  </include>
  <include if="$(arg start_semantic)" file="$(find rgb_sem_segmentation)/launch/rgb_segmentation_real_robot_sunny.launch">
    <arg name="cpu_threads" value="$(arg semantic_cpu_threads)"/>
    <arg name="cpu_nice" value="$(arg semantic_cpu_nice)"/>
  </include>
  <include if="$(arg start_cloud)" file="$(find scan2shape_launch)/launch/real_robot_process_cloud_node.launch">
    <arg name="odom_topic" value="/vins_estimator/odometry"/>
  </include>
  <include if="$(arg start_cop)" file="$(find exploration_manager)/launch/global_plan_server.launch"/>
  <include if="$(arg start_planner)" file="$(find exploration_manager)/launch/real_robot_planning_sunny.launch">
    <arg name="handheld_auto" value="$(arg handheld_auto)"/>
    <arg name="handheld_height_limit" value="$(arg handheld_height_limit)"/>
    <arg name="handheld_z_min" value="$(arg handheld_z_min)"/>
    <arg name="handheld_z_max" value="$(arg handheld_z_max)"/>
    <arg name="handheld_z_samples" value="$(arg handheld_z_samples)"/>
  </include>
  <include if="$(arg start_rviz)" file="$(find exploration_manager)/launch/real_robot_rviz.launch"/>
</launch>
