+// Only retain planning results; live map/frontier updates keep their existing behavior.
+void PlanningVisualization::publishRetainedMarker(
+    const ros::Publisher& pub, const visualization_msgs::Marker& marker) {
+  const auto topic = pub.getTopic();
+  if (topic != viewpoint_pub_.getTopic() && topic != goal_point_pub.getTopic() &&
+      topic != a_star_list_pub.getTopic()) {
+    pub.publish(marker);
+    return;
+  }
+  std::lock_guard<std::mutex> lock(retained_markers_mutex_);
+  const MarkerKey key(topic, marker.ns, marker.id);
+  if (marker.action == visualization_msgs::Marker::DELETEALL) {
+    for (auto it = retained_markers_.begin(); it != retained_markers_.end();) {
+      if (std::get<0>(it->first) == topic) it = retained_markers_.erase(it);
+      else ++it;
+    }
+  } else if (marker.action == visualization_msgs::Marker::DELETE) {
+    retained_markers_.erase(key);
+  } else {
+    retained_markers_[key] = std::make_pair(pub, marker);
+  }
+  pub.publish(marker);
+}
+
+void PlanningVisualization::replayMarkers(const ros::WallTimerEvent&) {
+  std::lock_guard<std::mutex> lock(retained_markers_mutex_);
+  for (const auto& entry : retained_markers_) {
+    if (entry.second.first.getNumSubscribers() > 0)
+      entry.second.first.publish(entry.second.second);
+  }
+}
