  <library_effects>
    <effect id="Material_006-effect">
      <profile_COMMON>
        <newparam sid="SeamlessCarbonFiber_jpg-surface">
          <surface type="2D">
            <init_from>SeamlessCarbonFiber_jpg</init_from>
          </surface>
        </newparam>
        <newparam sid="SeamlessCarbonFiber_jpg-sampler">
          <sampler2D>
            <source>SeamlessCarbonFiber_jpg-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="SeamlessCarbonFiber_jpg-sampler" texcoord="UVMap"/>
            </diffuse>
            <index_of_refraction>
              <float sid="ior">1</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
